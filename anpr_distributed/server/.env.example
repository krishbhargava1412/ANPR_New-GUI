# ── DRDO ANPR Server Environment Variables ────────────────────────────────────
# Copy this to .env and modify for your deployment.

# Database (PostgreSQL)
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=anpr
DATABASE_USER=anpr
DATABASE_PASSWORD=change-me-in-production

# JWT Authentication
JWT_SECRET=generate-a-random-64-char-secret-here

# Server
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://192.168.1.100:3000

# Edge Node API Key (must match on Jetson)
EDGE_API_KEY=generate-a-random-api-key-here

# Snapshots storage
SNAPSHOTS_DIR=./data/snapshots

# Logging
LOG_LEVEL=INFO
