# ── Jetson Edge Node Environment Variables ────────────────────────────────────
# Copy this to .env and modify for your deployment.

# DRDO Server Connection
ANPR_SERVER_URL=http://192.168.1.100:8000
EDGE_API_KEY=generate-a-random-api-key-here
EDGE_NODE_ID=jetson-gate-01

# Camera Sources (comma-separated RTSP URLs or USB device indices)
# Example: 4 IP cameras
CAMERA_SOURCES=rtsp://admin:pass@192.168.1.10:554/stream1,rtsp://admin:pass@192.168.1.11:554/stream1,rtsp://admin:pass@192.168.1.12:554/stream1,rtsp://admin:pass@192.168.1.13:554/stream1

# Inference
YOLO_MODEL_PATH=./assets/models/LicensePlateDetector.pt
CONFIDENCE_THRESHOLD=0.5
FRAME_SKIP=5
PROXY_RESOLUTION=true
USE_TENSORRT=false
# Set to true after running: yolo export model=LicensePlateDetector.pt format=engine half=True

# Store & Forward
LOCAL_DB_PATH=./data/edge_buffer.db
BATCH_PUSH_INTERVAL=5
MAX_LOCAL_BUFFER=10000

# Watchlist
WATCHLIST_SYNC_INTERVAL=60

# Thermal Management
THERMAL_THROTTLE_TEMP=80.0
THERMAL_THROTTLE_FPS=5
NORMAL_FPS=15

# Heartbeat
HEARTBEAT_INTERVAL=30

# Snapshots
SNAPSHOTS_DIR=./data/snapshots
SAVE_SNAPSHOTS=true
